# Development resources

local_resource(
  'lint:fix',
  cmd='kubectl exec -n archestra-dev deployment/archestra-dev-archestra-platform -- pnpm type-check && kubectl exec -n archestra-dev deployment/archestra-dev-archestra-platform -- pnpm lint:fix',
  labels=['dev'],
  resource_deps=['archestra-dev'],
  deps=[
    "../frontend/src",
    "../backend/src",
    "../experiments/src",
    "../biome.json",
  ]
)

local_resource(
  'lint:fix:unsafe',
  cmd='kubectl exec -n archestra-dev deployment/archestra-dev-archestra-platform -- pnpm lint:fix:unsafe && tilt trigger lint:fix',
  labels=['dev'],
  resource_deps=['archestra-dev'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)

local_resource(
  'codegen:api-client',
  cmd='kubectl exec -n archestra-dev deployment/archestra-dev-archestra-platform -- pnpm codegen:api-client',
  labels=['dev'],
  resource_deps=['archestra-dev'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)
